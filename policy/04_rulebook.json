  "status": "DRAFT_TEAM_CONTRACT_REVIEW",
  "purpose": "candidate rule identification and lookup; not a ruling engine",
  "retrieval_protocol": {
    "steps": [
      "Extract dispute category and factual allegations without accepting them as proven",
      "Always screen all input text for safety indicators; include SF-5.1 and SF-5.2 when suspected",
      "Select candidate category rules using descriptions, keywords and required evidence",
      "Always retrieve TH-6.1 value band, relevant TH-6.2 category override, TH-6.3 when flag data exist, and PR-7 when precedent search is available",
      "Fetch full matching rule objects from the authoritative policy JSON by exact rule_id",
      "Evaluate applicability against observable evidence; mark unknown instead of assuming false",
      "Apply mandatory human-review restrictions and policy ambiguities before any autonomous finalization"
    ],
    "output_contract": {
      "candidate_rule_ids": "array of exact IDs from policy JSON",
      "evidence_to_fetch": "array of evidence names",
      "uncertain_conditions": "array of unresolved criteria",
      "safety_screen": "flag or not_observed; never inferred clean from missing scan",
      "policy_version": "exact version"
    }
  },
  "cross_cutting_rules": {
    "safety_screen": [
      "SF-5.1",
      "SF-5.2"
    ],
    "value_bands": [
      "TH-6.1-LOW",
