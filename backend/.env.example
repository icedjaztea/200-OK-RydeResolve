# Start fully offline. Never commit the actual .env.
APP_MODE=memory
AI_MODE=mock
POLICY_SIGNOFF_PATH=policy/contract_approval.json
# Demo-only authorization: generate random values for hosted demo.
DEMO_RIDER_KEY=change-rider-key
DEMO_DRIVER_KEY=change-driver-key
DEMO_REVIEWER_KEY=change-reviewer-key
# Frontend origin; comma-separated for multiple trusted sites.
ALLOWED_ORIGINS=http://localhost:3000
# Cloud mode settings (do not set until cloud setup is complete)
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-2.5-flash
# Firestore emulator only for local tests, not hosted Cloud Run
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
